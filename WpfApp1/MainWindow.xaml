<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        mc:Ignorable="d"
        Title="图片转换"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI, PingFang SC, sans-serif"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CaptionHeight="0"
                      CornerRadius="14"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- 最外层 Border：圆角 + 阴影 + 背景 -->
    <Border CornerRadius="14" Background="{StaticResource BgBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="2"
                              Color="#000000" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 自定义标题栏 ===== -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"/>

                    <!-- 右侧：最小化 + 关闭按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 最小化按钮 -->
                        <Button x:Name="MinimizeBtn"
                                Width="46" Height="42"
                                Style="{StaticResource TitleBarButton}"
                                Click="MinimizeBtn_Click"
                                ToolTip="最小化">
                            <TextBlock Text="─" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- 关闭按钮 -->
                        <Button x:Name="CloseBtn"
                                Width="46" Height="42"
                                Style="{StaticResource TitleBarCloseButton}"
                                Click="CloseBtn_Click"
                                ToolTip="关闭">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 主内容区域 ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,18,24,24">


                <!-- ========== Hero 区域 ========== -->
                <Border Style="{StaticResource CardPanel}"
                        Background="#E5FFFFFF"
                        Padding="32,28,32,24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0"
                                          Color="#172033" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- 标题 -->
                        <TextBlock Text="图片转换"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"/>

                        <!-- 描述 -->
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="15" Foreground="{StaticResource MutedBrush}"
                                   LineHeight="26"
                                   Text="可选择单个/多个文件，也可选择整个文件夹。程序会读取文件头识别真实格式，而不是依赖扩展名，然后转换为指定格式。单张图片会直接保存单个文件；多张图片或文件夹会保留原目录结构并打包成 ZIP。所有处理都在本机完成，不上传网络。"
                                   TextWrapping="Wrap"/>

                        <!-- Badge 行 -->
                        <ItemsControl Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Items>
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,8,6">
                                    <TextBlock Text="🔍 文件头识别" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BadgeTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,8,6">
                                    <TextBlock Text="📁 文件 / 文件夹输入" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BadgeTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,8,6">
                                    <TextBlock Text="🖼 JPG / PNG / WebP / AVIF 输出" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BadgeTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,8,6">
                                    <TextBlock Text="🍎 HEIC / HEIF 支持" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BadgeTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,8,6">
                                    <TextBlock Text="📦 自动单文件或 ZIP" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BadgeTextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,0,8,6">
                                    <TextBlock Text="🖥 桌面原生性能" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BadgeTextBrush}"/>
                                </Border>
                            </ItemsControl.Items>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ========== 操作面板网格 ========== -->
                <UniformGrid Columns="2" Margin="0,16,0,0">

                    <!-- 1A. 选择文件 -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="1A. 选择图片文件" FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <Button Content="📂 选择文件..."
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SelectFilesCommand}"
                                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                                    HorizontalAlignment="Stretch"/>
                            <TextBlock Margin="0,8,0,0" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" LineHeight="18"
                                       Text="可以选单个或多个文件。不使用扩展名过滤，方便处理扩展名奇怪或无扩展名的图片。"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 1B. 选择文件夹 -->
                    <Border Style="{StaticResource CardPanel}" Margin="8,0,0,8">
                        <StackPanel>
                            <TextBlock Text="1B. 选择文件夹" FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <Button Content="📁 选择文件夹..."
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SelectFolderCommand}"
                                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                                    HorizontalAlignment="Stretch"/>
                            <TextBlock Margin="0,8,0,0" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" LineHeight="18"
                                       Text="递归读取文件夹内所有文件。多文件夹可多次选择，输出 ZIP 时会保留目录结构。"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 拖放区域 -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,8,8,8" Grid.ColumnSpan="2">
                        <Border Background="{StaticResource DropBgBrush}"
                                BorderBrush="{StaticResource DropBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                Padding="24"
                                AllowDrop="True"
                                DragEnter="DropZone_DragEnter"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop"
                                x:Name="DropZoneBorder">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📥 也可以把文件或文件夹拖到这里"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="拖拽文件夹会递归读取所有子文件。"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- 2. 输出格式 -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,8,8,0">
                        <StackPanel>
                            <TextBlock Text="2. 输出格式" FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{x:Static vm:MainViewModel.AvailableFormats}"
                                      SelectedItem="{Binding TargetFormat}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"/>
                            <CheckBox Content="已经是目标格式时不重新压缩，直接输出原文件内容"
                                      IsChecked="{Binding AvoidReencode}"
                                      IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                                      Margin="0,12,0,0" FontSize="13"
                                      Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. 质量 -->
                    <Border Style="{StaticResource CardPanel}" Margin="8,8,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="3. 有损格式质量：" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding Quality, StringFormat={}{0:F2}}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                            <Slider Minimum="0.50" Maximum="1.00"
                                    Value="{Binding Quality}"
                                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Margin="0,12,0,0"/>
                            <TextBlock Text="影响 JPG / WebP / AVIF / HEIC。PNG / BMP 是无损格式。"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,6,0,0" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. ZIP 文件名 -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,8,8,0">
                        <StackPanel>
                            <TextBlock Text="4. ZIP 文件名" FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding ZipName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBoolConverter}}"/>
                            <TextBlock Text="当输出多张图片或输入为文件夹时使用。单张图片会直接保存，不打包。"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,0" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ========== 操作按钮 ========== -->
                <WrapPanel Margin="0,20,0,0">
                    <Button Content="🚀 开始转换"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartConvertCommand}"
                            Margin="0,0,12,8"/>
                    <Button Content="🔍 只识别格式"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ScanOnlyCommand}"
                            Margin="0,0,12,8"/>
                    <Button Content="⏹ 取消"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,12,8"/>
                    <Button Content="🗑 清空记录"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearCommand}"
                            Margin="0,0,12,8"/>
                </WrapPanel>

                <!-- ========== 统计面板 ========== -->
                <UniformGrid Columns="5" Margin="0,18,0,0">
                    <Border Style="{StaticResource CardPanel}" Background="{StaticResource StatBgBrush}"
                            Margin="0,0,6,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="已选择文件" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}" Background="{StaticResource StatBgBrush}"
                            Margin="0,0,6,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding ImageCount}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="识别为图片" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}" Background="{StaticResource StatBgBrush}"
                            Margin="0,0,6,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding DoneCount}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource OkBrush}"/>
                            <TextBlock Text="成功转换" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}" Background="{StaticResource StatBgBrush}"
                            Margin="0,0,6,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding SkipCount}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource WarnBrush}"/>
                            <TextBlock Text="跳过文件" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}" Background="{StaticResource StatBgBrush}"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding FailCount}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource ErrBrush}"/>
                            <TextBlock Text="失败文件" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ========== 进度条 ========== -->
                <Border Style="{StaticResource CardPanel}" Margin="0,16,0,0">
                    <StackPanel>
                        <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100"/>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ========== 日志区域 ========== -->
                <Border Style="{StaticResource CardPanel}" Margin="0,16,0,0" Padding="0">
                    <Border Background="{StaticResource LogBgBrush}"
                            CornerRadius="18" Padding="14">
                        <ScrollViewer x:Name="LogScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="320">
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource LogTextBrush}"
                                     FontFamily="Consolas, Cascadia Code, Microsoft YaHei UI, monospace"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Disabled"
                                     x:Name="LogTextBox"/>
                        </ScrollViewer>
                    </Border>
                </Border>

                <!-- ========== 格式支持说明 ========== -->
                <Border Style="{StaticResource CardPanel}" Margin="0,16,0,0" Grid.ColumnSpan="2">
                    <StackPanel>
                        <TextBlock Text="当前识别/转换策略"
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                            <Border Background="{StaticResource StatBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="12" Margin="0,0,6,6">
                                <TextBlock FontSize="12" Foreground="{StaticResource BadgeTextBrush}"
                                           LineHeight="20"
                                           Text="可识别并转换：JPEG、PNG、GIF、WebP、BMP、HEIC、HEIF、AVIF、TIFF。基于 ImageMagick，支持 100+ 格式。"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="{StaticResource StatBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="12" Margin="6,0,0,6">
                                <TextBlock FontSize="12" Foreground="{StaticResource BadgeTextBrush}"
                                           LineHeight="20"
                                           Text="苹果 HEIC/HEIF：通过 Magick.NET 原生解码，无需额外安装组件，直接转换。"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="{StaticResource StatBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="12" Margin="0,6,6,0">
                                <TextBlock FontSize="12" Foreground="{StaticResource BadgeTextBrush}"
                                           LineHeight="20"
                                           Text="安卓格式：WebP / AVIF / JPEG / PNG 均按文件头识别，不依赖扩展名或 MIME。"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="{StaticResource StatBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="12" Margin="6,6,0,0">
                                <TextBlock FontSize="12" Foreground="{StaticResource BadgeTextBrush}"
                                           LineHeight="20"
                                           Text="专业格式：TIFF、BMP、GIF 等；RAW（CR2、DNG）是否能转换取决于系统编解码器。"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ========== 底部提示 ========== -->
                <TextBlock Margin="0,16,0,24"
                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                           LineHeight="22"
                           Text="注意：转换为 JPG 会丢失透明通道并自动铺白底；桌面端转换通常保留 EXIF 元数据。图片很多或单张特别大时建议分批处理。"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Border>
</Window>
